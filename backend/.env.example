DB_ENGINE=sqlite
DB_NAME=tianshuipy
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
SECRET_KEY=change_me_to_a_random_secret_key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_PUBLIC_USER_REGISTRATION=False
ALLOW_ANONYMOUS_ANALYSIS_UPLOADS=False
ALLOW_ANONYMOUS_BUSINESS_LAYER_ADMIN=False
ALLOW_ANONYMOUS_OVERLAY_ADMIN=False
ALLOW_PUBLIC_FEEDBACK_MANAGEMENT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USERNAME=admin
GEOSERVER_PASSWORD=change_me
GEOSERVER_WORKSPACE=tianshuipy
# 生产环境：接口只入队；Redis 与 Worker 解耦执行 GIS 重计算。
CELERY_TASK_ALWAYS_EAGER=false
CELERY_BROKER_URL=redis://:change_me@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:change_me@127.0.0.1:6379/1
# Windows 本地交付脚本使用线程池；Linux 生产建议 Celery prefork，设置为 CPU 核数。
TIANSHUI_CELERY_CONCURRENCY=8
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
